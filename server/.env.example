PORT=3000
# Postgres connection string. Add ?sslmode=require for a remote database.
DATABASE_URL=postgres://ferry:password@localhost:5432/ferry
RETENTION_DAYS=30
# Set behind a reverse proxy so client IPs are logged correctly
TRUST_PROXY=true
# Required to create an account. Leave empty only on a private network.
INVITE_CODE=

# APNs (iOS pushes) — .p8 key from developer.apple.com → Keys.
# With docker-compose, put it at server/secrets/apns.p8 and use /secrets/apns.p8.
# APNS_KEY_* is the production key. A "Sandbox & Production" key covers debug builds too;
# with an app-scoped key (one environment each), add the sandbox key under APNS_SANDBOX_KEY_*.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_SANDBOX_KEY_PATH=
APNS_SANDBOX_KEY_ID=
APNS_TEAM_ID=

# FCM (Android receiver pushes) — Firebase service account JSON. Optional.
FCM_SERVICE_ACCOUNT_PATH=
